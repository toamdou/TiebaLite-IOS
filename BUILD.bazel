# Bazel entry point: `bazel build //:App` (simulator Debug by default, see .bazelrc).
load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_xcodeproj//xcodeproj:defs.bzl", "xcodeproj")

package(default_visibility = ["//visibility:public"])

alias(
    name = "TiebaNative",
    actual = "//Sources/TiebaNative:TiebaNative",
)

ios_application(
    name = "App",
    app_icons = ["//TiebaLite:app_icon"],
    bundle_id = "com.tiebalite.app",
    bundle_name = "tiebalite",
    entitlements = "//TiebaLite:tiebalite.entitlements",
    extensions = ["//Extensions/TiebaLiveActivity:extension"],
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = ["//TiebaLite:app_info_plist"],
    minimum_os_version = "26.0",
    # Unset unless --config=device (or --define=apple.device_signing=1) is passed.
    provisioning_profile = select({
        "//TiebaLite:device_signing": "//Signing:profile_app",
        "//conditions:default": None,
    }),
    resources = ["//TiebaLite:app_resources"],
    sdk_frameworks = [
        "BackgroundTasks",
        "CoreGraphics",
        "ImageIO",
        "Security",
        "UIKit",
    ],
    deps = ["//TiebaLite:tiebalite_lib"],
)

xcodeproj(
    name = "xcodeproj",
    top_level_targets = ["//:App"],
)

# 交付用正式包：//:App 的产物做一遍符号剥离（体积约 -12%；为什么剥离要在 Bazel 之外，
# 见 Tools/strip-ipa-symbols.sh 头注）。用法：
#   bazel build //:AppStripped --config=ci --config=release  → bazel-bin/AppStripped.ipa
# ⚠️ 剥离会破坏代码签名：这个包是给 SideStore 侧载用的（与 CI 的隐私消毒同一口径）；
# 要 devicectl 直装真机就建 //:App（签名有效、符号未剥）。
# //:App 的默认输出不止一个（IPA + dSYM），所以先按扩展名挑出 IPA 再交给脚本。
genrule(
    name = "AppStripped",
    srcs = [":App"],
    outs = ["AppStripped.ipa"],
    cmd = """
ipa=""
for f in $(locations :App); do
  case "$$f" in *.ipa) ipa="$$f" ;; esac
done
$(location //Tools:strip-ipa-symbols) "$$ipa" $@
""",
    tools = ["//Tools:strip-ipa-symbols"],
)
