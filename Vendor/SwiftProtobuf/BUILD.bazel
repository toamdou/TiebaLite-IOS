# SwiftProtobuf 1.38.1 sources, vendored from the CocoaPods checkout (ios/Pods/SwiftProtobuf).
# Runtime for the generated code in //Sources/TiebaNative/Proto/Generated.
# The bundled PrivacyInfo.xcprivacy is a no-op manifest (no data/tracking/reason APIs) and is
# not embedded, to avoid clashing with the app's own PrivacyInfo.xcprivacy in the app bundle.
load("@rules_swift//swift:swift_library.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

swift_library(
    name = "SwiftProtobuf",
    srcs = glob(
        ["Sources/SwiftProtobuf/**/*.swift"],
        exclude = ["Sources/SwiftProtobuf/PrivacyInfo.xcprivacy"],
    ),
    features = ["swift.enable_v6"],
    module_name = "SwiftProtobuf",
    # Sources use Swift `package` access (SE-0386), which requires -package-name.
    package_name = "SwiftProtobuf",
)
