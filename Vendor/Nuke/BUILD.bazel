# Nuke 13.2.0, vendored from upstream tag 13.2.0 (MIT, see LICENSE).
# The podspec next to this file is used by the CocoaPods path; this BUILD file is the Bazel path.
load("@rules_swift//swift:swift_library.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# Swift 6 language mode is required: Nuke 13's actor isolation is only checked there.
swift_library(
    name = "Nuke",
    srcs = glob(["Sources/Nuke/**/*.swift"]),
    features = ["swift.enable_v6"],
    module_name = "Nuke",
)

swift_library(
    name = "NukeExtensions",
    srcs = glob(["Sources/NukeExtensions/**/*.swift"]),
    features = ["swift.enable_v6"],
    module_name = "NukeExtensions",
    deps = [":Nuke"],
)
