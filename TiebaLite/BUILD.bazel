# App 目标（壳）：入口源码、资源、Info.plist 与签名开关。
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# Referenced from //:App (cross-package file reference).
exports_files([
    "PrivacyInfo.xcprivacy",
    "tiebalite.entitlements",
])

swift_library(
    name = "tiebalite_lib",
    srcs = ["AppDelegate.swift"],
    features = ["swift.enable_v6"],
    # Xcode build uses PRODUCT_MODULE_NAME = tiebalite (see $(PRODUCT_MODULE_NAME) in Info.plist).
    module_name = "tiebalite",
    deps = ["//Sources/TiebaNative:TiebaNative"],
)

# 图标按部署底线二选一（rules_apple/actool.bzl 的硬规矩）：≥26 可以用 Icon Composer 的
# *.icon 包，<26 必须用 *.appiconset（.icon 在低底线**不产出任何图标条目**，
# CFBundleIconName 会悬空）。底线 17 这条分支只能走 AppIcon.appiconset。
#
# 2026-10-07 的经过（从 main 带过来）：曾换用 Icon Composer 文档（expo.icon → AppIcon.icon，
# 拆成 fill + 透明底 mark 图层），图标切换能力有了但 actool 要重新渲染合成，Assets.car
# 大了约 2.5MB；而"深色/透明能否切"在模拟器上没能验证出来（系统切深色时自家 App 的图标
# 都换了、本 App 没换）。按用户口径退回**单张平面图**这条最小、最稳的路：
#   · 名字就叫 AppIcon（资源目录名即包内 CFBundleIconName）；
#   · 想恢复"深色/着色"只需往同一个 appiconset 的 Contents.json 里再加
#     icon-1024-dark.png / icon-1024-tinted.png 两项（各约 50KB），不必回到图层方案。
filegroup(
    name = "app_icon",
    srcs = glob(["Images.xcassets/AppIcon.appiconset/**"]),
)

filegroup(
    name = "app_resources",
    srcs = glob(
        ["Images.xcassets/**"],
        exclude = ["Images.xcassets/AppIcon.appiconset/**"],
    ) + [
        "PrivacyInfo.xcprivacy",
        "SplashScreen.storyboard",
        # 「关于」页 hero 图：那张图按 bundle 相对路径直读（不是资源目录图片），
        # 必须是随包分发的松散文件；原先是读 expo.icon 里的源图，而 .icon 文档只被
        # actool 编进 Assets.car、源文件不进包 ⇒ 那条路径一直是悬空的。
        "AboutIcon.png",
        # 超分辨率模型（PiperSR_2x，CoreML，cc-by-4.0）：三个**原始文件**随包分发，运行期按
        # mlpackage 规范结构拼回目录再编译一次并缓存（.mlpackage/.mlmodelc 都是目录，而 genrule
        # 的 outs 只能是文件 —— 见 TiebaSuperResolutionModelStore 的头注释）。
        # 文件名两条硬约束：
        #   ① 带 PiperSR_2x_ 前缀：app_resources 按 basename 扁平落盘，"Manifest.json" 会撞名；
        #   ② 规格文件必须是 **.bin**（不能叫 .mlmodel）：rules_apple 见到 .mlmodel 会自动跑
        #      coremlc compile，而扁平落盘的 .mlmodel 找不到同目录的 weights/weight.bin
        #      （实测报错 Could not open .../weights/weight.bin）。改成不透明扩展名即绕过自动编译，
        #      由运行期自己拼目录编译；将来若改成随包预编译，把 .mlmodelc 目录塞进来即可
        #      （TiebaSuperResolutionModelStore 会优先用它，代码不用改）。
        "piper-sr/PiperSR_2x_Manifest.json",
        "piper-sr/PiperSR_2x_model.bin",
        "piper-sr/PiperSR_2x_weight.bin",
        # 运行时必需：信息流端点（frsPage/feedThreadList/userLike）走 TiebaSwiftProto
        # 描述符解码（TiebaProtoRegistry.loadBundled），删掉即 preconditionFailure。
        "//Sources/TiebaNative:Proto/proto-descriptors.json",
    ],
)

# rules_apple substitutes most $(...) build variables itself, but not PRODUCT_MODULE_NAME (used by
# UISceneDelegateClassName); resolving it here keeps the checked-in Info.plist untouched.
expand_template(
    name = "app_info_plist",
    out = "Info.bazel.plist",
    substitutions = {
        "$(EXECUTABLE_NAME)": "tiebalite",
        "$(PRODUCT_MODULE_NAME)": "tiebalite",
    },
    template = "Info.plist",
)

# Device Debug signing is opt-in: drop the .mobileprovision files in Signing/ and use --config=device.
config_setting(
    name = "device_signing",
    define_values = {"apple.device_signing": "1"},
)
